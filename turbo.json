{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json", 
    "pnpm-lock.yaml",
		".env.example",
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["APP_ENV", "API_BASE_URL"],
      "outputs": ["dist/**"]
    },
    "@repo/database#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/prisma/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}