{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json",
    "pnpm-lock.yaml",
    ".env.example"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["APP_ENV", "API_BASE_URL"],
      "outputs": ["dist/**"]
    },
    "@fedstack/database#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/prisma/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "lint": {
      "inputs": [
        "src/**",
        "*.{js,ts,jsx,tsx,json,md,yaml,yml}",
        "eslint.config.*"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
