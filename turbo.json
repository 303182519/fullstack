{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "packages/tooling/tsconfig/base.json",
    "pnpm-lock.yaml",
    ".env.example"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "@fedstack/database#build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**"]
    },
    "db:generate": {
      "outputs": ["generated/prisma/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@fedstack/database#typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "inputs": [
        "src/**",
        "*.{js,ts,jsx,tsx,json,md,yaml,yml}",
        "eslint.config.*"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
