# 环境变量样例（复制为 .env 使用；.env 已被 .gitignore 忽略，切勿提交真实凭证）

# ---- 共享持久化层（packages/database）----
# api 与 admin-api 访问同一个 MySQL 库，schema 与迁移由 packages/database 统一维护。
# 该变量既被两个服务的运行时读取，也是 Prisma CLI（migrate/generate）执行迁移所必需的。
# 连接串格式：mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://user:password@localhost:3306/fedstack"

# 单进程连接池上限。两个服务各自持有一个连接池，两者之和需明显小于 MySQL 的 max_connections。
DB_CONNECTION_LIMIT=10

# ---- 文件存储（P3a，ADR-012）----
# 单一活动驱动：local（本地磁盘，默认）| s3（S3 兼容对象存储）。切换存储 = 改这里 + 重启。
# 凭据只走 env，绝不入库、不进日志。
# STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=storage

# driver=s3 时 REGION 必填（启动期 Joi 校验）；endpoint 仅 AWS 官方可留空（SDK 按 region 自动推导），
# 阿里云 OSS / 腾讯云 COS / MinIO 等其它 S3 兼容服务均须显式填写
# STORAGE_S3_ENDPOINT=https://minio.example.com
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=fedstack-files
# 留空则走 SDK 默认凭证链（环境变量 / IAM 角色），只有 AWS 才能使用默认凭证链
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# MinIO 等自建端点须为 true；AWS S3 / 阿里云 OSS / 腾讯云 COS 为 false
# STORAGE_S3_FORCE_PATH_STYLE=true
# 预签名直连 URL 有效期（秒）
# STORAGE_SIGNED_URL_TTL=300

# ---- 上传面约束（P3a，ADR-012 D3/D4，服务端强制）----
# 图片类单文件上限（字节，默认 5 MiB）；其它白名单类型（默认 20 MiB）
# UPLOAD_MAX_BYTES=5242880
# UPLOAD_MAX_BYTES_OTHER=20971520
# 逗号分隔的 MIME 白名单
# UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
# UPLOAD_ALLOWED_FILE_TYPES=application/pdf,application/zip,text/plain,text/csv,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
# 封面归一化最大宽度（不放大小图）与输出格式（webp | jpeg | png）
# UPLOAD_COVER_MAX_WIDTH=1600
# UPLOAD_COVER_FORMAT=webp
# 封面输出质量（1-100，仅 webp / jpeg 生效）
# UPLOAD_COVER_QUALITY=82
# 图片像素边长硬上限（宽或高超过即拒绝上传，防解码期内存放大）
# UPLOAD_IMAGE_MAX_DIMENSION=10000

# ---- 实时推送 SSE（P3b，ADR-013 D5/D6）----
# 单进程并发 SSE 连接上限（多实例总上限 = 实例数 × 该值），超限返回 503 让客户端稍后重连
# REALTIME_MAX_CONNECTIONS=1000
# 心跳间隔（毫秒）：防 nginx / 云 LB 空闲断连（常见空闲超时 60s），取值需小于中间层空闲超时
# REALTIME_HEARTBEAT_MS=30000

