# 环境变量样例（复制为 .env 使用；.env 已被 .gitignore 忽略，切勿提交真实凭证）
# 覆盖 apps/admin-api 的全部配置项（权威来源：apps/admin-api/src/config/env.validation.ts）
# 注意：turbo 启动时各 app 的工作目录为 apps/<app>，@nestjs/config 默认读取 cwd 下的 .env；
# 根目录 .env 仅作模板，实际运行需复制到 apps/admin-api/.env（或由部署平台注入）。

# ---- 服务 ----
# admin-api 监听端口（api 为 3000）
# PORT=3001
# NODE_ENV=production 时加载 config.production.ts，否则加载 config.development.ts
# NODE_ENV=development

# ---- Swagger ----
# SWAGGER_OPEN=true

# ---- JWT（必填）----
# 生产环境必须替换为足够长的随机串，生成：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
# access token 有效期（秒），默认 7200（2 小时）
# JWT_ACCESS_EXPIRES_IN=7200
# refresh token 有效期（秒），默认 604800（7 天）
# JWT_REFRESH_EXPIRES_IN=604800

# ---- 雪花 ID ----
# 工作节点 / 数据中心 ID，范围 0-31；多实例部署时各实例须不同
# WORKER_ID=0
# DATACENTER_ID=0

# ---- 数据库 MySQL（必填）----
# 连接串格式：mysql://USER:PASSWORD@HOST:PORT/DATABASE
# 既被运行时读取，也是 Prisma CLI（migrate/generate）执行迁移所必需的
DATABASE_URL="mysql://root:123456@localhost:3306/test2"
# 单进程连接池上限；api 与 admin-api 各自持有一个连接池，两者之和需明显小于 MySQL max_connections
# DB_CONNECTION_LIMIT=10

# ---- 日志（Pino）----
# LOG_LEVEL=info
# LOG_JSON_FORMAT=true
# 慢请求阈值（毫秒）：响应耗时超过此值追加 [SLOW] 标记
# LOG_SLOW_REQUEST_THRESHOLD=500
# 慢查询阈值（毫秒）：单条 SQL 耗时达到此值打印 [SLOW_QUERY]
# LOG_SLOW_QUERY_THRESHOLD=500
# 输出目标：console | file
# LOG_OUTPUT=console
# LOG_DIR=logs
# 单文件最大 MB 与保留的轮转文件数（0 = 不限制）
# LOG_MAX_FILE_SIZE=10
# LOG_MAX_FILES=7

# ---- Redis ----
# URL 与 HOST 二选一（Joi oxor），也可都不配置（缓存降级为内存 store）
REDIS_URL="redis://localhost:6379"
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# 缓存默认 TTL（秒，0 = 不过期）
# REDIS_DEFAULT_TTL=300
# 多 app 共享 Redis 实例时前缀是唯一隔离手段（ADR-003），默认与 app 同名
# REDIS_KEY_PREFIX=admin-api

# ---- 全局限流（@nestjs/throttler，存储走 Redis）----
# 计数窗口（毫秒）与单窗口上限：默认 120 次/分钟/IP
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=120
# 超限后额外阻塞时长（毫秒）
# THROTTLE_BLOCK_DURATION=60000

# ---- 文件存储（ADR-012）：凭据只走 env，不入库、不进日志 ----
# 单一活动驱动：local（本地磁盘，默认）| s3（S3 兼容对象存储）。切换存储 = 改这里 + 重启
# STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=storage
# driver=s3 时 REGION 与 BUCKET 必填（启动期 Joi 校验）；
# endpoint 仅 AWS 官方可留空，MinIO / COS / OSS 必须显式填写
# STORAGE_S3_ENDPOINT=https://minio.example.com
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=fedstack-files
# 留空则走 SDK 默认凭证链（环境变量 / IAM 角色）
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# MinIO 等自建端点须为 true；AWS S3 为 false
# STORAGE_S3_FORCE_PATH_STYLE=true
# 预签名直连 URL 有效期（秒）
# STORAGE_SIGNED_URL_TTL=300

# ---- 上传面约束（ADR-012 D3/D4，服务端强制）----
# 图片类单文件上限（字节，默认 5 MiB）；其它白名单类型（默认 20 MiB）
# UPLOAD_MAX_BYTES=5242880
# UPLOAD_MAX_BYTES_OTHER=20971520
# 逗号分隔的 MIME 白名单
# UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
# UPLOAD_ALLOWED_FILE_TYPES=application/pdf,application/zip,text/plain,text/csv,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
# 封面归一化最大宽度（不放大小图）与输出格式（webp | jpeg | png）
# UPLOAD_COVER_MAX_WIDTH=1600
# UPLOAD_COVER_FORMAT=webp
# 封面输出质量（1-100，仅 webp / jpeg 生效；png 走无损压缩）
# UPLOAD_COVER_QUALITY=82
# 图片像素边长硬上限（宽或高超过即拒绝上传，防解码期内存放大）
# UPLOAD_IMAGE_MAX_DIMENSION=10000

# ---- SMTP 邮件（ADR-013 D10：凭据走 env，不入库）----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# ---- MFA（ADR-013 D8）----
# AES-256-GCM 主密钥，hex 编码 64 字符（32 字节）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未配置时 MFA 模块降级（启动 warn，绑定/解绑接口 503）
# MFA_SECRET_ENC_KEY=
