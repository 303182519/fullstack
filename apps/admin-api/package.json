{
  "name": "@fedstack/admin-api",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "基于 NestJS 构建的企业级后台管理系统",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@fedstack/auth-core": "workspace:*",
    "@fedstack/database": "workspace:*",
    "@fedstack/health": "workspace:*",
    "@fedstack/redis": "workspace:*",
    "@keyv/redis": "catalog:",
    "@nestjs-cls/transactional": "catalog:",
    "@nestjs-cls/transactional-adapter-prisma": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/cache-manager": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/throttler": "catalog:",
    "argon2": "catalog:",
    "bullmq": "catalog:",
    "cache-manager": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "cookie-parser": "catalog:",
    "es-toolkit": "catalog:",
    "ioredis": "catalog:",
    "joi": "catalog:",
    "keyv": "catalog:",
    "multer": "catalog:",
    "nestjs-cls": "catalog:",
    "nestjs-pino": "catalog:",
    "nodemailer": "catalog:",
    "otpauth": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "pino-roll": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "catalog:",
    "svg-captcha": "catalog:"
  },
  "devDependencies": {
    "@fedstack/eslint-config": "workspace:*",
    "@fedstack/tsconfig": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "source-map-support": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
