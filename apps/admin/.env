# .env 文件
# 用途: 定义项目的基本环境变量，这些变量在所有环境中都会被加载。


# 作用:
# PUBLIC_ 前缀的变量会被 rsbuild 自动注入到客户端代码中，可以通过 import.meta.env.PUBLIC_MY_APP_NAME 访问。
# 这些变量在开发环境、生产环境和测试环境中都会生效。


# 名称
PUBLIC_MY_APP_NAME = admin-web

# ── 业务状态码（与服务环境无关，放基础 env 避免各环境重复）──
# admin-api 信封为 { code, data, message, bizCode }，@fedstack/service 按 bizCode 优先、
# 缺失回落 HTTP 回声码 code 匹配（见 packages/web/service/src/request/shared.ts）。
PUBLIC_SERVICE_SUCCESS_CODE = 200
# access token 缺失/非法/过期（AuthBizCode.INVALID_ACCESS_TOKEN）→ 触发静默续签并重试
# 不能配 HTTP 401：登录密码错误（10A02）、租户不可用（10A07）也是 401，
# 配 401 会让「密码输错」也去走续签分支
PUBLIC_SERVICE_EXPIRED_TOKEN = 10A08
# 会话已被强制下线（AuthBizCode.SESSION_REVOKED）→ 直接清凭据并跳登录
PUBLIC_SERVICE_LOGOUT = 10A09
