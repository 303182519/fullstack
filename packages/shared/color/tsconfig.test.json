{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "测试项目：仅供 typecheck 脚本使用；用例运行在 node 环境，允许 Node 内置模块",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "rootDir": ".",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
