{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Monorepo 共享 TS 基座：环境无关的最小公共集；module/moduleResolution/lib/装饰器/declaration 由 node/web preset 提供",
  "compilerOptions": {
    // 是否启用增量编译。
    // "true" 表示启用增量编译。
    // "false" 表示禁用增量编译。
    // "incremental": true,
    // 指定最终生成 JavaScript 的版本。
    "target": "ES2023",
    // 是否解析 package.json 中的 exports 字段。
    // "true" 表示解析 exports 字段。
    // "false" 表示不解析 exports 字段。
    "resolvePackageJsonExports": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "removeComments": true,
    "sourceMap": true,
    // 是否允许使用 synthetic default imports。
    // "true" 表示允许使用 synthetic default imports。
    // "false" 表示不允许使用 synthetic default imports。
    "allowSyntheticDefaultImports": true,
    // 是否允许使用 ES module interop。
    // "true" 表示允许使用 ES module interop。
    // "false" 表示不允许使用 ES module interop。
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // 是否将每个文件编译为独立的模块。
    // "true" 表示将每个文件编译为独立的模块。
    // "false" 表示将所有文件编译为单个模块。
    "isolatedModules": true,
    "skipLibCheck": true
  }
}
