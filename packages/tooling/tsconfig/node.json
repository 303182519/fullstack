{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Node/NestJS 侧 preset：nodenext 模块解析 + 装饰器元数据 + 声明产物；apps 与 node/shared/tooling 层包继承",
  "extends": "./base.json",
  "compilerOptions": {
    // 指定模块系统：按 package.json type 判定 ESM/CJS。
    "module": "nodenext",
    // 指定模块解析策略：Node.js 20 的模块解析策略。
    "moduleResolution": "nodenext",
    // NestJS DI 依赖装饰器与反射元数据，仅 Node 侧开启（web 包不继承，避免误用）。
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // node 层包经 tsc -p 直建，必须产出 .d.ts。
    "declaration": true
  }
}
