}

enum Gender {
  MALE    @map("male")
  FEMALE  @map("female")
  UNKNOWN @map("unknown")
}

enum RoleStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

enum DataScope {
  ALL            @map("all") // 全部数据
  DEPT_AND_CHILD @map("dept_and_child") // 本部门及以下
}

enum MenuType {
  DIRECTORY @map("directory") // 目录（纯分组，无路由）
  MENU      @map("menu") // 菜单（页面，有路由）
  BUTTON    @map("button") // 按钮（操作点，对应具体 API）
}

enum MenuStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

enum DeptStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
