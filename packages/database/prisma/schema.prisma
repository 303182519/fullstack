// 共享持久化层的单一 schema 真相源。
//
// 约定：
// - 数据源 url 不在 schema 中声明，统一由 prisma7.config.ts 从环境变量注入（Prisma 7 约定）。
// - 生成产物输出到包根 generated/prisma（已被根 .gitignore 忽略），再由本包编译进 dist。
// - 数据模型在此集中定义，两个服务（api / admin-api）共用；业务查询不得写入本包。
// - 迁移历史（prisma/migrations）是线性的，只能由本包生成与执行，服务进程禁止触发迁移。

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        BigInt    @id // 不要写 @default(autoincrement())：主键由代码层雪花算法生成
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3) // 软删除：null=未删除，有值=删除时间

  email    String? @unique @db.VarChar(255) // 可空：OAuth 用户（如微信）可能无邮箱；非 NULL 值仍互斥，邮箱注册防重不变
  username String  @unique @db.VarChar(100)
  password String? @db.VarChar(255) // 可空：OAuth 用户可能无密码；有值时存哈希
}
