{
  "name": "@fedstack/service",
  "type": "module",
  "version": "0.0.1",
  "description": "平台无关的请求 & 查询基础设施：Adapter 模式注入平台差异，业务错误分流、token 续签去重、QueryClient 统一配置、请求体信封加密可跨端复用",
  "license": "UNLICENSED",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./crypto": "./src/crypto/index.ts",
    "./query": "./src/query/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./src/*"
      ]
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./crypto": {
        "import": {
          "types": "./dist/crypto/index.d.ts",
          "default": "./dist/crypto/index.js"
        }
      },
      "./query": {
        "import": {
          "types": "./dist/query/index.d.ts",
          "default": "./dist/query/index.js"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5"
  },
  "dependencies": {
    "@fedstack/axios": "workspace:*",
    "axios": "catalog:",
    "node-forge": "catalog:"
  },
  "devDependencies": {
    "@fedstack/config": "workspace:*",
    "@fedstack/eslint-config": "workspace:*",
    "@rslib/core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/node-forge": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
