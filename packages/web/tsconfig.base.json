{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Web 层共享 TS 基座：bundler 模块解析 + DOM lib，供 packages/web/* 各包继承",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  }
}
