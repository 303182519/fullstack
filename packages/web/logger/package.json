{
  "name": "@fedstack/logger",
  "type": "module",
  "version": "0.0.1",
  "description": "跨平台日志库：基于 LogLayer，Web 端 IndexedDB 本地存储 + 设备白名单 + 批量上传 + 过期清理，预留 React Native / 小程序适配",
  "license": "UNLICENSED",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./src/*"
      ]
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "dependencies": {
    "@loglayer/transport": "catalog:",
    "idb": "catalog:",
    "loglayer": "catalog:",
    "nanoid": "catalog:",
    "serialize-error": "catalog:"
  },
  "devDependencies": {
    "@fedstack/config": "workspace:*",
    "@fedstack/eslint-config": "workspace:*",
    "@fedstack/tsconfig": "workspace:*",
    "@react-native-async-storage/async-storage": "catalog:",
    "@rslib/core": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "fake-indexeddb": "catalog:",
    "msw": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
