{
  "name": "fedstack",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "description": "企业级 Monorepo 底座",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "lint": "eslint . && turbo run lint",
    "lint:fix": "eslint . --fix && turbo run lint -- --fix"
  },
  "devDependencies": {
    "@fedstack/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "turbo": "catalog:"
  }
}
